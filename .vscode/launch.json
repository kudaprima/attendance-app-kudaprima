{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter: Android AVD (Firebase Emulators)",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/mobile",
      "program": "${workspaceFolder}/apps/mobile/lib/main.dart",
      "flutterMode": "debug",
      "toolArgs": ["--dart-define=USE_FIREBASE_EMULATORS=true"]
    },
    {
      "name": "Flutter: Physical Android (Firebase Emulators)",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/mobile",
      "program": "${workspaceFolder}/apps/mobile/lib/main.dart",
      "flutterMode": "debug",
      "toolArgs": [
        "--dart-define=USE_FIREBASE_EMULATORS=true",
        "--dart-define=FIREBASE_EMULATOR_HOST=127.0.0.1"
      ]
    }
  ]
}
