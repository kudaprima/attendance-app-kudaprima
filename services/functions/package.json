{
  "name": "@kuda-prima/functions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "lint": "oxlint src test",
    "seed:auth-emulator": "pnpm build && node lib/development/seed-auth-emulator.js",
    "seed:profile-emulator": "pnpm build && node lib/development/seed-profile-emulator.js",
    "seed:production": "pnpm build && node lib/development/seed-production-online.js",
    "test": "vitest run --exclude \"test/*.emulator.test.ts\"",
    "test:emulator": "vitest run .emulator.test.ts --no-file-parallelism",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@kuda-prima/contracts": "workspace:*",
    "firebase-admin": "14.3.0",
    "firebase-functions": "7.3.2",
    "jpeg-js": "^0.4.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.18.0",
    "oxlint": "1.80.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
