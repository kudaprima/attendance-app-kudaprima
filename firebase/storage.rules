rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /attendance-selfies/{userId}/{fileName} {
      allow read: if request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.active == true
        && (request.auth.uid == userId
          || (request.auth.token.role in ['admin', 'supervisor']
            && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == request.auth.token.role));
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
