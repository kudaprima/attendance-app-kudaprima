rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function callerProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeUser() {
      return signedIn()
        && (isBootstrapAdmin() || callerProfile().active == true);
    }

    function isManager() {
      return signedIn()
        && (
          isBootstrapAdmin()
          || (
            callerProfile().active == true
            && callerProfile().role == 'admin'
            && (!('role' in request.auth.token) || request.auth.token.role == 'admin')
          )
        );
    }

    function validOptionalString(value, maximumLength) {
      return value == null
        || (value is string && value.size() <= maximumLength);
    }

    function validOwnProfileUpdate(userId) {
      let changedFields = request.resource.data.diff(resource.data).affectedKeys();
      return activeUser()
        && request.auth.uid == userId
        && changedFields.hasOnly([
          'phone',
          'homeAddress',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.fullName.size() <= 120
        && validOptionalString(request.resource.data.phone, 30)
        && validOptionalString(request.resource.data.birthDate, 10)
        && request.resource.data.gender in [null, 'male', 'female']
        && validOptionalString(request.resource.data.homeAddress, 500)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function validAttendanceCreate() {
      return activeUser()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.employeeId is string
        && request.resource.data.fullName is string
        && request.resource.data.eventType in ['check_in', 'check_out']
        && request.resource.data.capturedAt is string
        && request.resource.data.locationType in ['office', 'field']
        && request.resource.data.status in ['normal', 'late', 'early_departure', 'non_working_day']
        && request.resource.data.requiresApproval is bool;
    }

    function validManagerAttendanceApproval() {
      let changedFields = request.resource.data.diff(resource.data).affectedKeys();
      return isManager()
        && resource.data.userId != request.auth.uid
        && changedFields.hasOnly([
          'approvalStatus',
          'approvedBy',
          'approvedByName',
          'approvedAt',
          'approvalNotes',
          'updatedAt'
        ])
        && request.resource.data.approvalStatus in ['approved', 'rejected'];
    }

    function isBootstrapAdmin() {
      return signedIn()
        && request.auth.token.email in [
          'admin.utama@kudaprima.id',
          'admin.operasional@kudaprima.id'
        ];
    }

    match /users/{userId} {
      allow read: if signedIn()
        && (request.auth.uid == userId || isManager() || (resource != null && resource.data.email == request.auth.token.email));
      allow update: if validOwnProfileUpdate(userId) || isManager();
      allow create: if isManager()
        || (isBootstrapAdmin()
            && request.auth.uid == userId
            && request.resource.data.role == 'admin'
            && request.resource.data.active == true)
        || (signedIn()
            && !('role' in request.auth.token)
            && request.auth.uid == userId
            && request.resource.data.authUid == userId
            && request.resource.data.createdBy == userId
            && request.resource.data.role == 'technician'
            && request.resource.data.active in [true, false]);
      allow delete: if isManager() && request.auth.uid != userId;
    }

    match /systemCounters/{counterId} {
      allow read, write: if signedIn();
    }

    match /auditLogs/{auditId} {
      allow read: if isManager();
      allow create: if activeUser();
      allow update, delete: if false;
    }

    match /attendanceEvents/{eventId} {
      allow read: if activeUser()
        && (resource.data.userId == request.auth.uid || isManager());
      allow create: if validAttendanceCreate();
      allow update: if validManagerAttendanceApproval();
      allow delete: if false;
    }

    match /officeLocations/{officeId} {
      allow read: if activeUser()
        && (resource == null || resource.data.active == true);
      allow write: if isManager();
    }

    match /serviceRequests/{requestId} {
      allow read: if activeUser()
        && (resource.data.userId == request.auth.uid || isManager());
      allow create: if activeUser()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isManager()
        && resource.data.userId != request.auth.uid
        && request.resource.data.status in ['approved', 'rejected'];
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
