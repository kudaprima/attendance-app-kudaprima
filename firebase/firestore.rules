rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function activeUser() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }

    function isManager() {
      return activeUser()
        && request.auth.token.role in ['admin', 'supervisor'];
    }

    match /users/{userId} {
      allow read: if activeUser() && (request.auth.uid == userId || isManager());
      allow update: if activeUser()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['fullName', 'phone', 'birthDate', 'gender', 'homeAddress', 'updatedAt', 'updatedBy']);
      allow create, delete: if false;
    }

    match /attendanceEvents/{eventId} {
      allow read: if activeUser()
        && (resource.data.userId == request.auth.uid || isManager());
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
