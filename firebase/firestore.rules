rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function activeUser() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }

    function isManager() {
      return activeUser()
        && request.auth.token.role in ['admin', 'supervisor']
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == request.auth.token.role;
    }

    function validOptionalString(value, maximumLength) {
      return value == null
        || (value is string && value.size() <= maximumLength);
    }

    function validOwnProfileUpdate(userId) {
      let changedFields = request.resource.data.diff(resource.data).affectedKeys();
      return activeUser()
        && request.auth.uid == userId
        && changedFields.hasOnly([
          'phone',
          'homeAddress',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.fullName.size() <= 120
        && validOptionalString(request.resource.data.phone, 30)
        && validOptionalString(request.resource.data.birthDate, 10)
        && request.resource.data.gender in [null, 'male', 'female']
        && validOptionalString(request.resource.data.homeAddress, 500)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if signedIn()
        && (request.auth.uid == userId || isManager());
      allow update: if validOwnProfileUpdate(userId);
      allow create, delete: if false;
    }

    match /systemCounters/{counterId} {
      allow read, write: if false;
    }

    match /auditLogs/{auditId} {
      allow read, write: if false;
    }

    match /attendanceEvents/{eventId} {
      allow read: if activeUser()
        && (resource.data.userId == request.auth.uid || isManager());
      allow write: if false;
    }

    match /officeLocations/{officeId} {
      allow read: if activeUser() && resource.data.active == true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
