{
  "name": "@kuda-prima/attendance",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": "22.x",
    "pnpm": ">=10.33.0 <11"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:contracts": "pnpm --filter @kuda-prima/contracts build",
    "build:functions": "pnpm build:contracts && pnpm --filter @kuda-prima/functions build",
    "check": "pnpm check:brand && pnpm build:contracts && pnpm lint && pnpm typecheck && pnpm test",
    "check:brand": "node scripts/check-brand-system.mjs",
    "dev:admin": "pnpm --filter @kuda-prima/admin dev",
    "dev:functions": "pnpm build:contracts && pnpm --filter @kuda-prima/functions build:watch",
    "emulators": "pnpm build:functions && node scripts/start-persistent-emulators.mjs --all",
    "emulators:auth": "pnpm build:functions && node scripts/start-persistent-emulators.mjs --auth-only",
    "emulators:auth:seed": "pnpm build:contracts && pnpm --filter @kuda-prima/functions seed:auth-emulator",
    "emulators:profile": "pnpm build:functions && node scripts/start-persistent-emulators.mjs",
    "emulators:profile:seed": "pnpm build:contracts && pnpm --filter @kuda-prima/functions seed:profile-emulator",
    "seed:production": "pnpm build:contracts && pnpm --filter @kuda-prima/functions seed:production",
    "deploy:spark": "pnpm build && firebase deploy --only firestore,hosting --project kuda-prima-attandance-dev",
    "test:emulator:profile": "node scripts/test-emulators.mjs",
    "firebase": "firebase",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "emulators:save": "node scripts/save-emulators.mjs"
  },
  "devDependencies": {
    "firebase-tools": "15.28.2",
    "oxlint": "^1.80.0",
    "prettier": "3.9.6",
    "typescript": "~6.0.3",
    "vitest": "4.1.11"
  }
}
